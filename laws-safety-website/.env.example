# ── Resend: the contact form ("Get in touch with Stephen") ─────────────────
# Get an API key at https://resend.com/api-keys and verify laws-safety.com
# (or a subdomain such as web.laws-safety.com) as a sending domain.
# RESEND_FROM must use the verified domain, NOT resend.dev (which only delivers
# to the account owner and lands in spam).
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Laws Safety website <noreply@laws-safety.com>
# Where messages are delivered. Defaults to Stephen@Laws-Safety.com when unset.
# For testing, point it at a test inbox.
# CONTACT_TO=tomandrews1240@gmail.com

# ── IndexNow ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The key file is then served automatically at https://www.laws-safety.com/{KEY}.txt
INDEXNOW_API_KEY=your_indexnow_api_key_here
# Secret for the manual POST /api/indexnow trigger. The daily Vercel Cron
# authenticates with CRON_SECRET, which Vercel manages; set that in the
# Vercel dashboard (Settings → Environment Variables) as well.
INDEXNOW_SUBMIT_SECRET=generate_a_long_random_string
# CRON_SECRET=set_in_vercel

# ── Google Analytics 4 (optional) ──────────────────────────────────────────
# The gtag script loads only after the visitor accepts the analytics banner.
# Leave unset and nothing GA-related renders.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Search Console verification (optional) ─────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Rate limiting (optional; in-memory fallback when unset) ────────────────
# Free tier at https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Build ──────────────────────────────────────────────────────────────────
# `npm run build` refuses to ship while any [[placeholder]] remains in
# lib/content. Set this to 1 for a preview build only.
# ALLOW_PLACEHOLDERS=1
