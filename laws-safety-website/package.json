{
  "name": "laws-safety-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content-check.mjs --quiet && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "content:check": "node scripts/content-check.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:similarity": "node scripts/content-similarity.mjs",
